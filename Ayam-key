mini.Activated:Connect(function()
	bubble.Position = frame.Position
	frame.Visible = false
	bubble.Visible = true
end)

-- Geser dan ketuk bubble (dibuat manual supaya ketukan tidak tertelan)
local UIS = game:GetService("UserInputService")
local dragging = false
local moved = false
local dragStart, startPos

local function expand()
	frame.Position = bubble.Position
	bubble.Visible = false
	frame.Visible = true
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

bubble.InputBegan:Connect(function(input)
	if isPointer(input) then
		dragging = true
		moved = false
		dragStart = input.Position
		startPos = bubble.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if not moved then
					expand() -- ketukan biasa = buka menu
				end
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local d = input.Position - dragStart
		if d.Magnitude > 8 then moved = true end
		if moved then
			bubble.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end
end)

close.Activated:Connect(function()
	running = false
	dcOn = false
	if afkConn then afkConn:Disconnect() end
	gui:Destroy()
end)
end

-- ===== Jendela Key =====
local function getKeyParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok2 and cg then return cg end
	return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local function ShowKeyGui()
	local kparent = getKeyParent()
	local oldKey = kparent:FindFirstChild("AyamHubKey")
	if oldKey then oldKey:Destroy() end

	local keyGui = Instance.new("ScreenGui")
	keyGui.Name = "AyamHubKey"
	keyGui.ResetOnSpawn = false
	keyGui.Parent = kparent

	local kf = Instance.new("Frame")
	kf.Size = UDim2.new(0, 240, 0, 170)
	kf.Position = UDim2.new(0.5, -120, 0.25, 0)
	kf.BackgroundColor3 = Color3
